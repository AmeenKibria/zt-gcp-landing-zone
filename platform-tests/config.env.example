# Copy to config.env (git-ignored) and fill in. Never commit config.env.
# Values for your personal TEST organisation, never the commissioning one.
ORG_ID=000000000000
BILLING_ACCOUNT=000000-000000-000000
# An existing project in the test organisation, used only to carry API quota
# for your user credentials. See README step 3.
QUOTA_PROJECT=existing-project-id
# A new, globally unique project ID for the test, e.g. zt-plat-$(openssl rand -hex 3)
PROJECT_ID=zt-plat-xxxxxx
REGION=europe-north1
ZONE=europe-north1-a
# Organization Policy changes can take up to 15 minutes to take effect.
WAIT_SECONDS=900
RETRY_SECONDS=300
